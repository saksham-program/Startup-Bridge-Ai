# ─────────────────────────────────────────────────────────────────────────────
# StartupBridge AI — environment template.
# Copy to `.env` (never commit it):   cp .env.example .env
# A Supabase project is required for sign-up, sign-in and data.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (browser-safe values; Project Settings → API) ───────────────────
# Project URL, e.g. https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=
# The anon / publishable key. This is safe to expose to the browser.
VITE_SUPABASE_PUBLISHABLE_KEY=
# Project reference (the "abcdefghijklmnop" part of the URL). Informational / used by the Supabase CLI.
VITE_SUPABASE_PROJECT_ID=

# ── Server-only secrets (NEVER prefix with VITE_, never commit) ──────────────
# Service-role key: bypasses RLS. REQUIRED for new sign-ups: the server uses it to create the new user's
# profile + role after sign-up (without it the dashboard shows "Your workspace didn't load").
# Also used for notifications, audit logs and AI results. Supabase → Project Settings → API → service_role.
# Never put a VITE_ prefix on it (that would ship it to every browser), never commit it.
# After editing .env, restart the dev server (`npm run dev` / `bun run dev`).
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string used by `bun run db:migrate` / `bun run db:seed` only
# (Project Settings → Database → Connection string → URI).
DATABASE_URL=

# ── Optional AI provider (any OpenAI-compatible Chat Completions API) ────────
# Without these the app uses its built-in heuristic engine and labels the output accordingly.
AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# ── Deployment (build-time) ──────────────────────────────────────────────────
# Nitro preset override. The config wrapper defaults to Cloudflare. Examples: node-server, vercel, netlify, bun (untested here).
# NITRO_PRESET=node-server
